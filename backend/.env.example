# Local Postgres from compose.yaml (repo root). Use the POSTGRES_PASSWORD from the root .env.
DATABASE_URL=postgresql+psycopg://jobdots:your-postgres-password@127.0.0.1:55432/jobdots
# Where uploaded originals (resume files) are kept.
FILE_STORAGE_DIR=data/files

# Owner auth (single user): Authorization: Bearer <OWNER_API_TOKEN>, 32+ random characters.
# OWNER_ID optionally pins the owner's uuid (e.g. the old JobPilot user id).
OWNER_EMAIL=
OWNER_API_TOKEN=
OWNER_ID=

# LLM providers: Groq (cloud, free tier) and Ollama (local models), both OpenAI-compatible.
GROQ_API_KEY=your-groq-api-key
# Optional override (default: openai/gpt-oss-120b)
GROQ_MODEL=
# Ollama on this machine. Inside Docker Compose this is set to http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=embeddinggemma

# Provider for every agent: groq | ollama | auto (Groq when its key is set, else Ollama)
LLM_PROVIDER=auto

# Chat assistant: auto follows LLM_PROVIDER; groq | ollama to override for the chat only
AGENT_PROVIDER=auto
AGENT_MODEL=

# HR Contacts / Email enrichment
HUNTER_API_KEY=your-hunter-api-key

# Transactional/Cold Email Sender
RESEND_API_KEY=your-resend-api-key

# Sprint 4: server-side Composio project configuration (the chat plugin does not
# supply these). Register the OAuth callback identity verifier in Composio at
# https://your-frontend/settings, using a public HTTPS development tunnel if local.
# Configure Gmail send + readonly + userinfo.email scopes in its auth config.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
MAILBOX_ENABLED=false
MAIL_SEND_ENABLED=false
MAIL_SYNC_ENABLED=true
# Enable mailbox/sending only after setup, Sprint 4 migrations and a separate
# durable worker are ready. No mail is automatically approved or sent.

# Job Listing Search APIs
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# Durable execution: apply the Sprint 2 migration first. Set both API and
# worker to durable, then start a separate process: python -m app.workers.runner
EXECUTION_MODE=inline
RUN_LEASE_SECONDS=120
RUN_POLL_SECONDS=2

# Release settings. Local development defaults are deliberately unchanged.
# Production requires all release migrations, a separate worker, exact HTTPS
# origins and random backend-only SECRET_KEY/CRON_SECRET/OBSERVABILITY_TOKEN.
APP_ENV=development
USAGE_LIMITS_ENABLED=false
APPLICATION_DAILY_LIMIT=25
CHAT_DAILY_LIMIT=100

# Semantic job matching uses local Ollama embeddings (OLLAMA_EMBED_MODEL). When Ollama
# is not running, matching falls back to its lexical score; scans never call a cloud API.
MATCHING_SEMANTIC=true

# App Settings
FRONTEND_URL=http://localhost:5173
SECRET_KEY=generate-a-secure-random-key-for-jwt-cookie-auth
DEBUG=true

# Autopilot: nightly board scans (2h before your digest hour) and morning digests on the server (needs DATABASE_URL).
DISCOVERY_AUTO_SCAN=true

# Morning digest: uses RESEND_API_KEY above (free at resend.com; sends from onboarding@resend.dev to your own address).
DIGEST_FROM=JobPilot <onboarding@resend.dev>

# Secret for POST /api/v1/autopilot/tick, called every 10-15 min by a free cron (cron-job.org) so a sleeping
# Render free instance wakes up for the nightly scan and digest. Any long random string.
CRON_SECRET=

# Sprint 6: private JSON monitoring; use a long random backend-only token.
OBSERVABILITY_TOKEN=
REQUEST_LOGS_ENABLED=false
# Optional Sentry errors only. Request bodies, user data and tracing are disabled.
SENTRY_DSN=
