# Supabase Configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# LLM Providers API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
# Optional model overrides (defaults: openai/gpt-oss-120b, gpt-4o, claude-sonnet-5-5)
GROQ_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# Provider for every agent: auto = Anthropic, then OpenAI, then Groq (first with a key set)
LLM_PROVIDER=auto

# Resume-search embeddings: local (offline, default) | huggingface | openai
# Each has its own vector collection; re-save your base resume after switching.
EMBEDDINGS_PROVIDER=local

# Chat assistant: auto = Anthropic if configured, else Groq, else OpenAI
AGENT_PROVIDER=auto
AGENT_MODEL=

# HR Contacts / Email enrichment
HUNTER_API_KEY=your-hunter-api-key

# Transactional/Cold Email Sender
RESEND_API_KEY=your-resend-api-key

# Sprint 4: server-side Composio project configuration (the chat plugin does not
# supply these). Register the OAuth callback identity verifier in Composio at
# https://your-frontend/settings, using a public HTTPS development tunnel if local.
# Configure Gmail send + readonly + userinfo.email scopes in its auth config.
COMPOSIO_API_KEY=
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
MAILBOX_ENABLED=false
MAIL_SEND_ENABLED=false
MAIL_SYNC_ENABLED=true
# Enable mailbox/sending only after setup, Sprint 4 migrations and a separate
# durable worker are ready. No mail is automatically approved or sent.

# Job Listing Search APIs
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# Redis Task Queue URL
REDIS_URL=redis://localhost:6379/0

# Durable execution: apply the Sprint 2 migration first. Set both API and
# worker to durable, then start a separate process: python -m app.workers.runner
EXECUTION_MODE=inline
RUN_LEASE_SECONDS=120
RUN_POLL_SECONDS=2

# Matching v2 uses an already-installed local MiniLM model. Missing model files
# produce an explicit lexical fallback; scans never download or call an API.
MATCHING_SEMANTIC=true

# App Settings
FRONTEND_URL=http://localhost:5173
SECRET_KEY=generate-a-secure-random-key-for-jwt-cookie-auth
DEBUG=true

# Autopilot: nightly board scans (2h before your digest hour) and morning digests on the server (needs SUPABASE_SERVICE_KEY).
# Without the service key, the app scans when you open it and the last scan is over 20 hours old.
DISCOVERY_AUTO_SCAN=true

# Morning digest: uses RESEND_API_KEY above (free at resend.com; sends from onboarding@resend.dev to your own address).
DIGEST_FROM=JobPilot <onboarding@resend.dev>

# Secret for POST /api/v1/autopilot/tick, called every 10-15 min by a free cron (cron-job.org) so a sleeping
# Render free instance wakes up for the nightly scan and digest. Any long random string.
CRON_SECRET=

# Sprint 6: private JSON monitoring; use a long random backend-only token.
OBSERVABILITY_TOKEN=
REQUEST_LOGS_ENABLED=false
# Optional Sentry errors only. Request bodies, user data and tracing are disabled.
SENTRY_DSN=
