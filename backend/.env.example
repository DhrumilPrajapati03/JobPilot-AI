# Supabase Configurations
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# LLM Providers API Keys
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key
# Optional model overrides (defaults: openai/gpt-oss-120b, gpt-4o, claude-sonnet-5-5)
GROQ_MODEL=
OPENAI_MODEL=
ANTHROPIC_MODEL=

# Provider for every agent: auto = Anthropic, then OpenAI, then Groq (first with a key set)
LLM_PROVIDER=auto

# Resume-search embeddings: local (offline, default) | huggingface | openai
# Each has its own vector collection; re-save your base resume after switching.
EMBEDDINGS_PROVIDER=local

# Chat assistant: auto = Anthropic if configured, else Groq, else OpenAI
AGENT_PROVIDER=auto
AGENT_MODEL=

# HR Contacts / Email enrichment
HUNTER_API_KEY=your-hunter-api-key

# Transactional/Cold Email Sender
RESEND_API_KEY=your-resend-api-key

# Job Listing Search APIs
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_API_KEY=your-adzuna-api-key

# Redis Task Queue URL
REDIS_URL=redis://localhost:6379/0

# App Settings
FRONTEND_URL=http://localhost:5173
SECRET_KEY=generate-a-secure-random-key-for-jwt-cookie-auth
DEBUG=true

# Autopilot: nightly board scans (2h before your digest hour) and morning digests on the server (needs SUPABASE_SERVICE_KEY).
# Without the service key, the app scans when you open it and the last scan is over 20 hours old.
DISCOVERY_AUTO_SCAN=true

# Morning digest: uses RESEND_API_KEY above (free at resend.com; sends from onboarding@resend.dev to your own address).
DIGEST_FROM=JobPilot <onboarding@resend.dev>

# Secret for POST /api/v1/autopilot/tick, called every 10-15 min by a free cron (cron-job.org) so a sleeping
# Render free instance wakes up for the nightly scan and digest. Any long random string.
CRON_SECRET=
