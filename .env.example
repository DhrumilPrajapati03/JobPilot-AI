# Docker Compose settings for the local JobDots stack (compose.yaml).
# Copy to .env (git-ignored). Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Host ports; bound to 127.0.0.1 only.
POSTGRES_PORT=55432
API_PORT=8000

# The owner (single user). The API accepts: Authorization: Bearer <OWNER_API_TOKEN>
OWNER_EMAIL=
OWNER_API_TOKEN=
# Optional: pin the owner's id (for example the old JobPilot user id, so imported rows match).
OWNER_ID=

# Nightly encrypted backups (plan section 9.2). Create the key with
#   cd backend && python scripts/backup.py new-key
# and keep a copy in your password manager: without it no backup can be restored.
BACKUP_ENCRYPTION_KEY=
# Google Drive for backups (drive.file scope). Use your Google API client (not the login
# client), with redirect URI http://localhost:8080/, then run: python scripts/backup.py connect-drive
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
BACKUP_DRIVE_FOLDER_ID=
