# Docker Compose settings for the local JobDots stack (compose.yaml).
# Copy to .env (git-ignored). Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Host ports; bound to 127.0.0.1 only.
POSTGRES_PORT=55432
API_PORT=8000

# The owner (single user). OWNER_API_TOKEN is the break-glass sign-in (login page ->
# "Use owner token", or Authorization: Bearer <OWNER_API_TOKEN> from scripts).
# Google/GitHub login settings go in backend/.env (see backend/.env.example).
OWNER_EMAIL=
OWNER_API_TOKEN=
# Optional: pin the owner's id (for example the old JobPilot user id, so imported rows match).
OWNER_ID=
