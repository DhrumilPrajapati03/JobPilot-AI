# Docker Compose settings for the local JobDots stack (compose.yaml).
# Copy to .env (git-ignored). Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Host ports; bound to 127.0.0.1 only.
POSTGRES_PORT=55432
API_PORT=8000

# The owner (single user). The API accepts: Authorization: Bearer <OWNER_API_TOKEN>
OWNER_EMAIL=
OWNER_API_TOKEN=
# Optional: pin the owner's id (for example the old JobPilot user id, so imported rows match).
OWNER_ID=
